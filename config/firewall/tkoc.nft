#!/usr/sbin/nft -f
# the_king_of-casual / Fedora host firewall
#
# Scope:
#   - Host firewall for a single-user Fedora workstation.
#   - Default-deny inbound and forwarded traffic.
#   - Default-allow outbound, with optional DNS-port enforcement.
#   - Replaces only its own table; tables owned by other tools are untouched.
#
# This is not an application-aware egress firewall. In particular, it does not
# claim to block DNS-over-HTTPS, VPNs, Tor, proxies, or arbitrary HTTPS tunnels.
#
# TIER MARKERS
# ------------
# This is one template for three tiers, not three files. Lines beginning with a
# "# TKOC_NAME: " marker are inert comments until the renderer in
# stages/40-hardening.sh uncomments the markers that tier enables. Reading this
# file therefore shows the complete policy surface, including the parts a given
# tier leaves off.
#
#   TKOC_LAN_NOISE    strong, lockdown      drop LAN discovery/multicast chatter
#   TKOC_IPV6_OFF     when --ipv6 disabled  drop all off-host IPv6
#   TKOC_DNS_ENFORCE  lockdown, or --dns    pin DNS to ALLOWED_DNS4, drop DoT/DoQ
#   TKOC_SSH_ALLOW    --ssh/--ssh-source    scoped inbound TCP/22
#   TKOC_WG_ALLOW     wireguard stage       inbound WireGuard UDP
#
# The VM block between TKOC_VM_NET_BEGIN/END is rewritten in place by
# `tkoc vm net on|off`; it is not a tier marker.
#
# Deployment (all handled by `tkoc firewall <tier>`; shown for manual review):
#   1. Validate: nft --check --file /etc/nftables/tkoc.nft
#   2. Load:     nft --file /etc/nftables/tkoc.nft
#   3. Inspect:  nft list table inet tkoc_host
#
# `destroy table` is deliberately used instead of `flush ruleset`. It does not
# fail when this table is absent, and replacement through `nft -f` is atomic.
# It needs nftables >= 1.0.7 and Linux >= 6.3; Fedora 40+ satisfies both.

# Resolvers permitted on UDP/TCP 53 when DNS enforcement is on. Local stub
# resolvers on loopback are allowed independently by the loopback rules below,
# so systemd-resolved at 127.0.0.53 keeps working either way.
define ALLOWED_DNS4 = { 127.0.0.1 }

# Source scope for the optional inbound SSH carve-out. Only consulted when the
# TKOC_SSH_ALLOW marker is enabled; rendered from --ssh-source.
define SSH_SOURCE = { 127.0.0.1 }

# UDP port for the optional inbound WireGuard carve-out.
define WG_PORT = 51820

destroy table inet tkoc_host

table inet tkoc_host {
    comment "Fedora workstation host firewall; managed by the_king_of-casual"

    # Named counters keep diagnostics useful without logging every packet.
    counter input_invalid       { }
    counter input_spoofed       { }
    counter input_ipv6_blocked  { }
    counter input_noise_blocked { }
    counter input_ssh_accepted  { }
    counter input_wg_accepted   { }
    counter input_dropped       { }

    counter forward_invalid       { }
    counter forward_ipv6_blocked  { }
    counter forward_guest_new     { }
    counter forward_dropped       { }

    counter output_invalid      { }
    counter output_ipv6_blocked { }
    counter output_dns_blocked  { }
    counter output_dot_blocked  { }
    counter output_lan_noise_blocked { }
    counter output_allowed      { }

    chain input {
        type filter hook input priority filter; policy drop;

        # Local IPC, including ::1, remains available. systemd-resolved's stub
        # listener at 127.0.0.53 depends on this rule.
        iifname "lo" accept

        # Reject impossible or spoofed traffic before the established-flow rule.
        ct state invalid counter name input_invalid drop
        iifname != "lo" ip saddr 127.0.0.0/8 counter name input_spoofed drop

        # Off-host IPv6. This precedes conntrack so a pre-existing IPv6 flow
        # cannot survive a ruleset reload.
# TKOC_IPV6_OFF:         meta nfproto ipv6 counter name input_ipv6_blocked drop

        # Drop discovery multicast even if conntrack has seen prior traffic.
# TKOC_LAN_NOISE:         ip protocol igmp counter name input_noise_blocked drop
# TKOC_LAN_NOISE:         ip daddr 224.0.0.0/4 counter name input_noise_blocked drop

        # Replies to connections initiated by this host, plus genuinely related
        # traffic such as ICMP errors.
        ct state established,related accept

        # DHCPv4 server-to-client replies. DHCP itself is unauthenticated; this
        # merely permits the protocol NetworkManager needs on non-loopback
        # interfaces.
        iifname != "lo" udp sport 67 udp dport 68 accept

        # DHCPv6 client replies, only while IPv6 is permitted at all.
        iifname != "lo" udp sport 547 udp dport 546 accept

        # Essential IPv4 control traffic. Rate-limited so forged or flooded ICMP
        # errors cannot be used to waste cycles; excess falls through to the
        # final drop.
        ip protocol icmp icmp type {
            destination-unreachable,
            time-exceeded,
            parameter-problem
        } limit rate 10/second burst 20 packets accept
        ip protocol icmp icmp type echo-request limit rate 5/second burst 10 packets accept

        # ICMPv6 neighbour discovery is mandatory for a working IPv6 stack.
        # Only reachable when the TKOC_IPV6_OFF marker above is disabled.
        icmpv6 type {
            destination-unreachable,
            packet-too-big,
            time-exceeded,
            parameter-problem,
            nd-neighbor-solicit,
            nd-neighbor-advert,
            nd-router-advert
        } limit rate 10/second burst 20 packets accept

        # Keep routine LAN discovery noise out of the limited kernel log while
        # retaining a distinct counter for troubleshooting.
        # 137/138 NetBIOS, 1716 KDE Connect, 1900 SSDP, 5353 mDNS, 5355 LLMNR,
        # 27036 Steam. 139/445 are SMB.
# TKOC_LAN_NOISE:         udp dport { 137, 138, 1716, 1900, 27036, 5353, 5355 } counter name input_noise_blocked drop
# TKOC_LAN_NOISE:         tcp dport { 139, 445 } counter name input_noise_blocked drop

        # Optional inbound services. Both are off unless explicitly requested:
        # --ssh/--ssh-source for SSH, the wireguard stage for WireGuard.
# TKOC_SSH_ALLOW:         ip saddr $SSH_SOURCE tcp dport 22 ct state new limit rate 10/minute burst 5 packets counter name input_ssh_accepted accept
# TKOC_WG_ALLOW:         udp dport $WG_PORT counter name input_wg_accepted accept

        # Log only a bounded sample, then count and drop every unmatched packet.
        limit rate 5/second burst 10 packets log prefix "tkoc input drop: " flags all
        counter name input_dropped drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        ct state invalid counter name forward_invalid drop
# TKOC_IPV6_OFF:         meta nfproto ipv6 counter name forward_ipv6_blocked drop
        # TKOC_VM_NET_BEGIN
        # TKOC_VM_GUARD
        # Block guest traffic before the established-flow rule. Otherwise an
        # already connected guest keeps its network access after `vm off`.
        iifname "virbr*" counter drop
        oifname "virbr*" counter drop
        iifname "docker*" counter drop
        oifname "docker*" counter drop
        iifname "podman*" counter drop
        oifname "podman*" counter drop
        iifname "cni-podman*" counter drop
        oifname "cni-podman*" counter drop
        iifname "incusbr*" counter drop
        oifname "incusbr*" counter drop
        iifname "vboxnet*" counter drop
        oifname "vboxnet*" counter drop
        iifname "br-*" counter drop
        oifname "br-*" counter drop

        ct state established,related accept

        # Guest forwarding is disabled until `tkoc vm on` is run. Reapplying
        # a firewall tier returns to this closed state.
        #
        # This whole block is rewritten by `tkoc vm net on|off`; do not hand-edit
        # between the BEGIN/END markers.
# TKOC_VM_OFF:         iifname "virbr*" ct state new counter name forward_guest_new accept
# TKOC_VM_OFF:         iifname "virbr*" accept
# TKOC_VM_OFF:         iifname "docker*" ct state new counter name forward_guest_new accept
# TKOC_VM_OFF:         iifname "docker*" accept
# TKOC_VM_OFF:         iifname "podman*" ct state new counter name forward_guest_new accept
# TKOC_VM_OFF:         iifname "podman*" accept
# TKOC_VM_OFF:         iifname "cni-podman*" ct state new counter name forward_guest_new accept
# TKOC_VM_OFF:         iifname "cni-podman*" accept
# TKOC_VM_OFF:         iifname "incusbr*" ct state new counter name forward_guest_new accept
# TKOC_VM_OFF:         iifname "incusbr*" accept
# TKOC_VM_OFF:         iifname "vboxnet*" ct state new counter name forward_guest_new accept
# TKOC_VM_OFF:         iifname "vboxnet*" accept
# TKOC_VM_OFF:         iifname "br-*" ct state new counter name forward_guest_new accept
# TKOC_VM_OFF:         iifname "br-*" accept

        # Permit explicitly DNATed/published services to the corresponding guest
        # networks without allowing arbitrary new inbound forwarding.
# TKOC_VM_OFF:         oifname "virbr*" ct status dnat accept
# TKOC_VM_OFF:         oifname "docker*" ct status dnat accept
# TKOC_VM_OFF:         oifname "podman*" ct status dnat accept
# TKOC_VM_OFF:         oifname "cni-podman*" ct status dnat accept
# TKOC_VM_OFF:         oifname "incusbr*" ct status dnat accept
# TKOC_VM_OFF:         oifname "vboxnet*" ct status dnat accept
# TKOC_VM_OFF:         oifname "br-*" ct status dnat accept
        # TKOC_VM_NET_END

        limit rate 5/second burst 10 packets log prefix "tkoc forward drop: " flags all
        counter name forward_dropped drop
    }

    chain output {
        type filter hook output priority filter; policy accept;

        # Preserve local IPC and local DNS stubs, including ::1. This is what
        # keeps systemd-resolved usable under DNS enforcement.
        oifname "lo" accept

        ct state invalid counter name output_invalid drop

        # Off-host IPv6 and prohibited DNS transports are evaluated before the
        # established-flow accept, so existing flows cannot bypass a reload.
# TKOC_IPV6_OFF:         meta nfproto ipv6 counter name output_ipv6_blocked drop

        # Suppress host discovery and multicast chatter. DHCP client requests
        # remain permitted so dynamically configured networks keep working.
# TKOC_LAN_NOISE:         ip protocol igmp counter name output_lan_noise_blocked drop
# TKOC_LAN_NOISE:         ip daddr 224.0.0.0/4 counter name output_lan_noise_blocked drop
# TKOC_LAN_NOISE:         ip daddr 255.255.255.255 udp dport != 67 counter name output_lan_noise_blocked drop
# TKOC_LAN_NOISE:         udp dport { 137, 138, 1716, 1900, 27036, 5353, 5355 } counter name output_lan_noise_blocked drop

        # DNS enforcement. Everything on 53 that is not the chosen resolver is
        # dropped, as is DNS-over-TLS (TCP/853) and DNS-over-QUIC (UDP/853).
        # DoH cannot be separated from ordinary HTTPS here; see the threat model.
# TKOC_DNS_ENFORCE:         ip daddr $ALLOWED_DNS4 udp dport 53 accept
# TKOC_DNS_ENFORCE:         ip daddr $ALLOWED_DNS4 tcp dport 53 accept
# TKOC_DNS_ENFORCE:         udp dport 53 limit rate 2/second burst 5 packets log prefix "tkoc DNS block: " flags all
# TKOC_DNS_ENFORCE:         udp dport 53 counter name output_dns_blocked drop
# TKOC_DNS_ENFORCE:         tcp dport 53 limit rate 2/second burst 5 packets log prefix "tkoc DNS block: " flags all
# TKOC_DNS_ENFORCE:         tcp dport 53 counter name output_dns_blocked drop
# TKOC_DNS_ENFORCE:         meta l4proto { tcp, udp } th dport 853 limit rate 2/second burst 5 packets log prefix "tkoc encrypted DNS block: " flags all
# TKOC_DNS_ENFORCE:         meta l4proto { tcp, udp } th dport 853 counter name output_dot_blocked drop

        ct state established,related accept

        # Deliberately permissive workstation egress. Application-aware or
        # destination allowlisting should be a separate, opt-in policy because
        # generic nftables rules cannot reliably identify DoH inside HTTPS.
        counter name output_allowed accept
    }
}
